# Copy to .env and fill in every value. .env is gitignored; this file is not.
# No entry here has a usable default — every one must be set explicitly or the
# API fails to start (see CLAUDE.md, "Security rules").

# Credentials for the local Postgres container (compose.yml). Must match the
# user/password/db embedded in DATABASE_URL below.
POSTGRES_USER=<REPLACE_ME>
POSTGRES_PASSWORD=<REPLACE_ME>
POSTGRES_DB=<REPLACE_ME>

# Postgres connection string used by sqlx (api and storage crates, migrations).
# Wrong host/port/db name: connection refused at startup, nothing starts.
DATABASE_URL=<REPLACE_ME>

# Host:port the API binds to inside its own process/container, e.g. 0.0.0.0:8080.
# Wrong value: API unreachable, or port conflicts with another local service.
API_BIND_ADDRESS=<REPLACE_ME>

# Public origin of the Astro frontend, used to build absolute links (e.g.
# magic-link emails). Wrong value: emailed links point at the wrong host.
PUBLIC_WEB_ORIGIN=<REPLACE_ME>

# Comma-separated list of origins allowed by CORS on the API.
# Too permissive (e.g. "*") defeats the same-origin protections cookies rely
# on; too narrow and the browser silently blocks legitimate requests.
ALLOWED_CORS_ORIGINS=<REPLACE_ME>

# Symmetric key used to sign session cookies. Generate with:
#   openssl rand -base64 64
# Wrong or missing: process refuses to start (never falls back to a default).
# Rotating it invalidates every existing session.
SESSION_SIGNING_KEY=<REPLACE_ME>

# Symmetric key used to sign magic-link login tokens. Keep separate from
# SESSION_SIGNING_KEY so rotating one does not invalidate the other.
MAGIC_LINK_SIGNING_KEY=<REPLACE_ME>

# How long an issued magic link stays valid, in seconds, e.g. 900.
# Too long: a leaked link (e.g. from an email scan) stays exploitable longer.
MAGIC_LINK_TTL_SECONDS=<REPLACE_ME>

# S3-compatible endpoint for recipe image uploads (MinIO locally).
# Wrong value: uploads fail; images already stored become unreachable.
OBJECT_STORAGE_ENDPOINT=<REPLACE_ME>

# Bucket name uploads are written to and read from.
OBJECT_STORAGE_BUCKET=<REPLACE_ME>

# Object storage credentials (MinIO root user/password locally, an IAM
# access/secret key pair in a real deployment).
OBJECT_STORAGE_ACCESS_KEY=<REPLACE_ME>
OBJECT_STORAGE_SECRET_KEY=<REPLACE_ME>

# Outbound email provider, used for magic-link login and notifications.
# Wrong or missing credentials: magic-link login silently cannot deliver mail.
EMAIL_PROVIDER_API_KEY=<REPLACE_ME>
EMAIL_FROM_ADDRESS=<REPLACE_ME>
