{
  "name": "SmartCooking",
  "dockerComposeFile": [
    "../compose.yml",
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.98.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=moba-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=moba-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.config/gh && cargo install sqlx-cli --no-default-features --features rustls,postgres --locked",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "myriad-dreamin.tinymist",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "wayou.vscode-todo-highlight"
      ]
    }
  }
}
